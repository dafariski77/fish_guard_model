{
  "version": "1.0.0",
  "pipeline_name": "FishGuard Two-Stage Vision Pipeline",
  "pre_capture_checks": {
    "blur_detection": {
      "algorithm": "Laplacian_Variance",
      "minimum_threshold": 100.0,
      "recommendation_below_threshold": "Hold the camera steady and tap to focus."
    },
    "exposure_check": {
      "metric": "Average_Luminance_L_channel",
      "min_lum": 40.0,
      "max_lum": 225.0,
      "recommendation_low": "Lighting is too dark. Turn on torch / flash.",
      "recommendation_high": "Glare detected. Reposition camera to avoid reflection."
    }
  },
  "stage_1_detector": {
    "model_name": "fishguard_yolo_detector",
    "architecture": "YOLO-Nano Backbone with FPN & Dual Detection Heads",
    "input_tensor": {
      "name": "input_image",
      "shape": [1, 3, 320, 320],
      "data_type": "float32",
      "color_format": "RGB",
      "range": [0.0, 1.0],
      "normalization": {
        "mean": [0.485, 0.456, 0.406],
        "std": [0.229, 0.224, 0.225]
      }
    },
    "output_tensors": {
      "boxes": {
        "shape": [1, 84, 2100],
        "description": "Bounding box coordinates normalized [cx, cy, w, h] + class confidences"
      },
      "parsed_boxes": {
        "format": "normalized [x_min, y_min, width, height] in range 0.0 - 1.0",
        "classes": ["fish_eye", "fish_gill"],
        "confidence_threshold": 0.35,
        "iou_nms_threshold": 0.45
      }
    },
    "crop_padding_ratio": 0.15
  },
  "stage_2_classifier": {
    "model_name": "fishguard_multitask_mobilenet",
    "architecture": "MobileNetV3-Small Dual-Head Multi-Task Classifier",
    "input_tensors": {
      "whole_fish_image": {
        "shape": [1, 3, 224, 224],
        "data_type": "float32",
        "color_format": "RGB",
        "range": [0.0, 1.0],
        "normalization": {
          "mean": [0.485, 0.456, 0.406],
          "std": [0.229, 0.224, 0.225]
        }
      },
      "eye_crop_image": {
        "shape": [1, 3, 224, 224],
        "data_type": "float32",
        "color_format": "CIELab_Normalized",
        "range": [-1.0, 1.0],
        "normalization": {
          "L_range": [0, 100],
          "a_range": [-128, 127],
          "b_range": [-128, 127],
          "formula": "L_norm = (L - 50.0) / 50.0; a_norm = a / 128.0; b_norm = b / 128.0"
        }
      },
      "gill_crop_image": {
        "shape": [1, 3, 224, 224],
        "data_type": "float32",
        "color_format": "CIELab_Normalized",
        "range": [-1.0, 1.0],
        "normalization": {
          "L_range": [0, 100],
          "a_range": [-128, 127],
          "b_range": [-128, 127],
          "formula": "L_norm = (L - 50.0) / 50.0; a_norm = a / 128.0; b_norm = b / 128.0"
        }
      }
    },
    "outputs": {
      "species_logits": {
        "classes": 11,
        "softmax_threshold": 0.70
      },
      "eye_freshness_score": {
        "range": [0.0, 1.0],
        "activation": "sigmoid"
      },
      "gill_freshness_score": {
        "range": [0.0, 1.0],
        "activation": "sigmoid"
      }
    }
  },
  "cielab_conversion_reference": {
    "standard": "CIE 1976 (L*, a*, b*) using D65 illuminant",
    "opencv_code": "cv2.COLOR_RGB2LAB",
    "dart_equivalent": "Provided in Flutter helper cielab_converter.dart"
  }
}
